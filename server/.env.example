# Copy to .env (local) or set these in Render's "Environment" tab. Never commit real values.
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://your-app.onrender.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/speedclipper

# long random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=          # exactly 64 hex characters (32 bytes); encrypts YouTube/Instagram tokens
WORKER_KEY=              # the laptop worker sends this; put the same value in speed-clipper/.env as SPEEDCLIPPER_WORKER_KEY

# Google Cloud -> Credentials -> OAuth client ID -> "Web application"
# Authorised redirect URI: ${PUBLIC_URL}/api/accounts/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developers.facebook.com -> your app -> Facebook Login for Business
# Valid OAuth redirect URI: ${PUBLIC_URL}/api/accounts/instagram/callback
META_APP_ID=
META_APP_SECRET=
