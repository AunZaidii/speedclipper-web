{
  "name": "SpeedClipper",
  "short_name": "SpeedClipper",
  "description": "Live streams to Shorts and Reels, automatically.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfaf7",
  "theme_color": "#fbfaf7",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Review clips", "url": "/review", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Live streams", "url": "/streams", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
